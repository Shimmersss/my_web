{
  "name": "high-end-corporate-website",
  "version": "1.0.0",
  "description": "高端企业官网模板 - Vue 3 + Vite + Naive UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:pptd-editor": "node scripts/prepare-pptd-editor.mjs",
    "build": "npm run prepare:pptd-editor && node ../backen/scripts/check_html_template_previews.mjs && npm run check:navigation && npm run check:matchmaking-trial && npm run test:task-poller && npm run check:android-webview && vite build && npm run check:pwa && npm run test:pwa-check && npm run check:pdf-preview -- --dist dist",
    "check:navigation": "node scripts/check-navigation.mjs",
    "check:matchmaking-trial": "node scripts/check-matchmaking-trial.mjs",
    "check:pwa": "node scripts/check-pwa.mjs dist",
    "test:pwa-check": "node scripts/check-pwa-test.mjs dist",
    "check:pdf-preview": "node scripts/check-pdf-preview.mjs",
    "check:android-webview": "node scripts/check-android-webview.mjs",
    "preview": "vite preview",
    "test:task-poller": "node --test scripts/task-poller.test.mjs scripts/request.test.mjs"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "dompurify": "^3.4.7",
    "marked": "^18.0.4",
    "naive-ui": "^2.38.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@babel/parser": "7.29.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-sfc": "3.5.30",
    "sass": "^1.69.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.0"
  }
}
