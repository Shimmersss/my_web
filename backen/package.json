{
  "name": "shimmer-presentation-agent",
  "private": true,
  "type": "module",
  "description": "Provider-neutral agent worker and presentation tools used by the Spring Boot service",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test scripts/ppt-agent/*.test.mjs scripts/ppt-codex/*.test.mjs",
    "prepare:ppt-templates": "node scripts/ppt-agent/prepare-templates.mjs",
    "prepare:html-previews": "node scripts/generate_html_template_previews.mjs",
    "check:html-previews": "node scripts/check_html_template_previews.mjs",
    "preflight:ppt-fonts": "node scripts/ppt-agent/font-preflight.mjs",
    "prepare:codex-linux-sandbox": "node scripts/ppt-codex/ensure-codex-linux-sandbox.mjs",
    "verify:codex-linux-sandbox": "node scripts/ppt-codex/ensure-codex-linux-sandbox.mjs --check",
    "smoke:presentations": "node scripts/ppt-agent/visual-smoke.mjs"
  },
  "dependencies": {
    "@openai/codex": "0.147.0",
    "image-size": "^1.2.1",
    "jszip": "3.10.1",
    "playwright-core": "1.62.1",
    "pptx-automizer": "0.8.2",
    "reveal.js": "6.0.1",
    "undici": "6.28.0",
    "yaml": "2.8.1"
  }
}
